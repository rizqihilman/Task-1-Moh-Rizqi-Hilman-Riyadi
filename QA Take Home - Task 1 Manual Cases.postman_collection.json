    {
      "name": "GET /pet/findByStatus",
      "item": [
        {
          "name": "API-GET-001 Find pets by status=available",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Response is an array', () => pm.expect(list).to.be.an('array'));",
                  "pm.test('Every pet matches the requested status', () => {",
                  "    list.forEach(p => pm.expect(p.status, 'pet id ' + p.id).to.eql('available'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/findByStatus?status=available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "findByStatus"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "available"
                }
              ]
            }
          },
          "response": []
        },
