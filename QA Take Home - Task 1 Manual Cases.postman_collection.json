              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Created pet is present in the available list', () => {",
                  "    const id = Number(pm.collectionVariables.get('petId'));",
                  "    pm.expect(list.some(p => p.id === id), 'pet ' + id + ' not found in ' + list.length + ' entries').to.be.true;",
